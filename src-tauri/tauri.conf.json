{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MyStation",
  "mainBinaryName": "mystation",
  "version": "0.7.0",
  "identifier": "com.myprecision.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "Aleks Szotek",
    "shortDescription": "Battery and thermal control for Dell Precision"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCQTE3QjU5MTY0OEIyRDgKUldUWXNrZ1dXWHVoYTc5ZkpQOFQ4L2d4bzF4ODJhQ20zT0F6dHMreXVUWnBQaEc5QmZQQmdnM2YK",
      "endpoints": [
        "https://github.com/al3ksh/MyStation/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
