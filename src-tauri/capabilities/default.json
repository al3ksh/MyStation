{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the flyout, full window and records",
  "windows": [
    "flyout",
    "main",
    "records"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:event:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://www.dell.com/*" }, { "url": "ms-settings:startupapps" }]
    }
  ]
}
